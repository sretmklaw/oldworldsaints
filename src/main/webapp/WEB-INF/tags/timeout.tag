<%@ tag language="java" 
	pageEncoding="ISO-8859-1"%>

<!DOCTYPE html>
<html>
<head></head>
<body>

	<!-- Timeout Warning -->
	<div id="timeoutWarning" class="timeout-warning"> 
		<b>Your session will expire due to inactivity in:</b>
		<b><span class="alert"><span id="remainingTime">10</span> minutes</span></b>
		<b>Click anywhere to stay logged in.</b>
	</div>

	<!-- Timeout Warning Mask -->
	<div id="timeoutMask" class="page-mask"></div>

</body>